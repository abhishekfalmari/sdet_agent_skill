{
  "models": {
    "flake-detector": {
      "name": "Flake Detector",
      "description": "Detects flaky tests from execution history",
      "input_features": [
        "test_type",
        "priority",
        "component",
        "owner_team",
        "lines_of_code",
        "cyclomatic_complexity",
        "has_mock",
        "has_async",
        "uses_database",
        "uses_external_api",
        "test_age_days",
        "last_modified_days",
        "total_runs",
        "pass_rate",
        "avg_duration_ms",
        "duration_std",
        "flaky_rate",
        "consecutive_passes",
        "consecutive_failures",
        "failure_pattern",
        "recent_changes",
        "lines_changed",
        "files_changed",
        "author_churn",
        "is_new_test",
        "env_stability_score",
        "parallel_execution",
        "resource_contention"
      ],
      "output": "is_flaky (0=stable, 1=flaky)",
      "threshold": 0.5,
      "use_case": "Quarantine flaky tests, prioritize fixes"
    },
    "failure-predictor": {
      "name": "Failure Predictor",
      "description": "Predicts probability of test failure in next run",
      "input_features": [
        "test_type",
        "priority",
        "component",
        "owner_team",
        "lines_of_code",
        "cyclomatic_complexity",
        "has_mock",
        "has_async",
        "uses_database",
        "uses_external_api",
        "test_age_days",
        "last_modified_days",
        "total_runs",
        "pass_rate",
        "avg_duration_ms",
        "duration_std",
        "flaky_rate",
        "consecutive_passes",
        "consecutive_failures",
        "failure_pattern",
        "recent_changes",
        "lines_changed",
        "files_changed",
        "author_churn",
        "is_new_test",
        "env_stability_score",
        "parallel_execution",
        "resource_contention"
      ],
      "output": "will_fail_next (0=pass, 1=fail)",
      "threshold": 0.5,
      "use_case": "Risk-based test selection, pre-merge validation"
    },
    "test-prioritizer": {
      "name": "Test Prioritizer",
      "description": "Ranks tests by priority for maximum defect detection per time unit",
      "input_features": [
        "test_type",
        "priority",
        "component",
        "owner_team",
        "lines_of_code",
        "cyclomatic_complexity",
        "has_mock",
        "has_async",
        "uses_database",
        "uses_external_api",
        "test_age_days",
        "last_modified_days",
        "total_runs",
        "pass_rate",
        "avg_duration_ms",
        "duration_std",
        "flaky_rate",
        "consecutive_passes",
        "consecutive_failures",
        "failure_pattern",
        "recent_changes",
        "lines_changed",
        "files_changed",
        "author_churn",
        "is_new_test",
        "env_stability_score",
        "parallel_execution",
        "resource_contention"
      ],
      "output": "priority_rank (0-100), is_high_priority (0/1)",
      "threshold": "Top 20% by priority_rank",
      "use_case": "Test suite optimization, CI time reduction"
    },
    "root-cause": {
      "name": "Root Cause Classifier",
      "description": "Classifies failure root cause category",
      "input_features": [
        "test_type",
        "priority",
        "component",
        "owner_team",
        "lines_of_code",
        "cyclomatic_complexity",
        "has_mock",
        "has_async",
        "uses_database",
        "uses_external_api",
        "test_age_days",
        "last_modified_days",
        "total_runs",
        "pass_rate",
        "avg_duration_ms",
        "duration_std",
        "flaky_rate",
        "consecutive_passes",
        "consecutive_failures",
        "failure_pattern",
        "recent_changes",
        "lines_changed",
        "files_changed",
        "author_churn",
        "is_new_test",
        "env_stability_score",
        "parallel_execution",
        "resource_contention"
      ],
      "output": "root_cause (code_bug, environment, test_bug, data_issue, dependency, flaky, infrastructure)",
      "threshold": "Max probability class",
      "use_case": "Automated RCA, defect routing, prevention"
    }
  },
  "feature_engineering": {
    "categorical_encoding": "LabelEncoder per column",
    "numeric_scaling": "StandardScaler",
    "missing_values": "Not expected (synthetic data complete)",
    "feature_count": 27
  },
  "training": {
    "data_samples": 10000,
    "test_split": 0.2,
    "random_state": 42,
    "algorithms": "XGBoost (preferred), LightGBM, GradientBoosting, RandomForest"
  },
  "serving": {
    "format": "ONNX (primary), joblib (fallback)",
    "runtime": "ONNX Runtime (Python, Node.js, C#, Java)",
    "inference_time_ms": "<10ms per prediction",
    "batch_support": true
  },
  "versioning": {
    "strategy": "Semantic versioning (MAJOR.MINOR.PATCH)",
    "retraining_trigger": "Performance drift >5%, new data >10k samples",
    "ab_testing": "Canary deployment with 10% traffic"
  }
}