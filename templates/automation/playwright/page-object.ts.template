import { Page, Locator, expect } from '@playwright/test';
import { BasePage } from './base-page';

export class {{PAGE_NAME}}Page extends BasePage {
  // Page URL path (relative to baseURL)
  readonly url = '{{PAGE_URL}}';

  // Page title for verification
  readonly title = '{{PAGE_TITLE}}';

  // ============================================
  // LOCATORS - Using data-testid attributes preferred
  // ============================================

  // Header elements
  readonly header = this.page.locator('[data-testid="header"]');
  readonly logo = this.page.locator('[data-testid="logo"]');
  readonly navigation = this.page.locator('[data-testid="main-nav"]');

  // Main content
  readonly mainContent = this.page.locator('[data-testid="main-content"]');
  readonly pageTitle = this.page.locator('[data-testid="page-title"]');

  // {{FEATURE_SPECIFIC_LOCATORS}}
  {{#each LOCATORS}}
  readonly {{NAME}} = this.page.locator('[data-testid="{{TESTID}}"]');
  {{/each}}

  // Forms
  readonly formContainer = this.page.locator('[data-testid="form-{{FORM_NAME}}"]');
  {{#each FORM_FIELDS}}
  readonly {{FIELD_NAME}} = this.formContainer.locator('[data-testid="field-{{FIELD_NAME}}"]');
  readonly {{FIELD_NAME}}Error = this.formContainer.locator('[data-testid="field-{{FIELD_NAME}}-error"]');
  {{/each}}

  // Buttons
  readonly submitButton = this.formContainer.locator('[data-testid="btn-submit"]');
  readonly cancelButton = this.formContainer.locator('[data-testid="btn-cancel"]');
  {{#each BUTTONS}}
  readonly {{BUTTON_NAME}} = this.page.locator('[data-testid="btn-{{BUTTON_NAME}}"]');
  {{/each}}

  // Tables/Lists
  readonly dataTable = this.page.locator('[data-testid="table-{{TABLE_NAME}}"]');
  readonly tableRows = this.dataTable.locator('[data-testid="row"]');
  readonly emptyState = this.page.locator('[data-testid="empty-state"]');

  // Modals/Dialogs
  readonly modal = this.page.locator('[data-testid="modal-{{MODAL_NAME}}"]');
  readonly modalTitle = this.modal.locator('[data-testid="modal-title"]');
  readonly modalClose = this.modal.locator('[data-testid="modal-close"]');
  readonly modalConfirm = this.modal.locator('[data-testid="modal-confirm"]');

  // Notifications
  readonly toastContainer = this.page.locator('[data-testid="toast-container"]');
  readonly successToast = this.toastContainer.locator('[data-testid="toast-success"]');
  readonly errorToast = this.toastContainer.locator('[data-testid="toast-error"]');

  // Loading states
  readonly loadingSpinner = this.page.locator('[data-testid="loading-spinner"]');
  readonly skeletonLoader = this.page.locator('[data-testid="skeleton-loader"]');

  // ============================================
  // CONSTRUCTOR
  // ============================================

  constructor(page: Page) {
    super(page);
  }

  // ============================================
  // NAVIGATION & PAGE LOAD
  // ============================================

  /**
   * Navigate to this page and wait for load
   */
  async goto(): Promise<void> {
    await super.goto(this.url);
    await this.waitForLoad();
  }

  /**
   * Wait for page to be fully loaded
   */
  async waitForLoad(): Promise<void> {
    await this.waitForPageReady();
    await expect(this.pageTitle).toBeVisible();
    await expect(this.pageTitle).toHaveText(this.title);
  }

  /**
   * Verify page is loaded correctly
   */
  async verifyPageLoaded(): Promise<void> {
    await expect(this.page).toHaveURL(new RegExp(this.url.replace(':id', '.*')));
    await expect(this.pageTitle).toBeVisible();
    await expect(this.pageTitle).toHaveText(this.title);
  }

  // ============================================
  // FORM ACTIONS
  // ============================================

  /**
   * Fill form field with validation
   */
  async fillField(fieldName: string, value: string): Promise<void> {
    const field = this[`${fieldName}`] as Locator;
    await expect(field).toBeVisible();
    await field.clear();
    await field.fill(value);
    await this.waitForFieldValidation(fieldName);
  }

  /**
   * Fill multiple fields at once
   */
  async fillForm(data: Record<string, string>): Promise<void> {
    for (const [field, value] of Object.entries(data)) {
      await this.fillField(field, value);
    }
  }

  /**
   * Submit form and wait for response
   */
  async submitForm(): Promise<void> {
    await this.submitButton.click();
    await this.waitForResponse('/api/**');
  }

  /**
   * Cancel form
   */
  async cancelForm(): Promise<void> {
    await this.cancelButton.click();
    await this.waitForLoad();
  }

  /**
   * Get field validation error
   */
  async getFieldError(fieldName: string): Promise<string | null> {
    const errorEl = this[`${fieldName}Error`] as Locator;
    if (await errorEl.isVisible()) {
      return await errorEl.textContent();
    }
    return null;
  }

  // ============================================
  // TABLE ACTIONS
  // ============================================

  /**
   * Get row by cell value
   */
  async getRowByCellValue(columnIndex: number, value: string): Promise<Locator | null> {
    const rows = await this.tableRows.all();
    for (const row of rows) {
      const cell = row.locator(`td`).nth(columnIndex);
      if (await cell.textContent() === value) {
        return row;
      }
    }
    return null;
  }

  /**
   * Click action button in row
   */
  async clickRowAction(row: Locator, action: string): Promise<void> {
    const button = row.locator(`[data-testid="action-${action}"]`);
    await button.click();
  }

  /**
   * Get all row data as array of objects
   */
  async getTableData(): Promise<Record<string, string>[]> {
    const headers = await this.dataTable.locator('[data-testid="header-cell"]').allTextContents();
    const rows = await this.tableRows.all();
    const data = [];

    for (const row of rows) {
      const cells = await row.locator('[data-testid="cell"]').allTextContents();
      const rowData: Record<string, string> = {};
      headers.forEach((header, index) => {
        rowData[header] = cells[index] || '';
      });
      data.push(rowData);
    }
    return data;
  }

  // ============================================
  // MODAL ACTIONS
  // ============================================

  /**
   * Open modal by triggering element
   */
  async openModal(modalName: string): Promise<void> {
    const trigger = this.page.locator(`[data-testid="trigger-${modalName}"]`);
    await trigger.click();
    await this.waitForModal(modalName);
  }

  /**
   * Wait for modal to appear
   */
  async waitForModal(modalName: string): Promise<void> {
    const modal = this.page.locator(`[data-testid="modal-${modalName}"]`);
    await expect(modal).toBeVisible({ timeout: 5000 });
  }

  /**
   * Confirm modal action
   */
  async confirmModal(modalName: string): Promise<void> {
    const modal = this.page.locator(`[data-testid="modal-${modalName}"]`);
    await modal.locator('[data-testid="modal-confirm"]').click();
    await expect(modal).toBeHidden({ timeout: 5000 });
  }

  /**
   * Close modal without confirming
   */
  async closeModal(modalName: string): Promise<void> {
    const modal = this.page.locator(`[data-testid="modal-${modalName}"]`);
    await modal.locator('[data-testid="modal-close"]').click();
    await expect(modal).toBeHidden({ timeout: 5000 });
  }

  // ============================================
  // ASSERTIONS
  // ============================================

  /**
   * Assert toast message appears
   */
  async expectSuccessToast(message?: string): Promise<void> {
    await expect(this.successToast).toBeVisible({ timeout: 5000 });
    if (message) {
      await expect(this.successToast).toContainText(message);
    }
  }

  async expectErrorToast(message?: string): Promise<void> {
    await expect(this.errorToast).toBeVisible({ timeout: 5000 });
    if (message) {
      await expect(this.errorToast).toContainText(message);
    }
  }

  /**
   * Assert element is visible
   */
  async expectVisible(locatorName: string): Promise<void> {
    const locator = this[locatorName] as Locator;
    await expect(locator).toBeVisible();
  }

  /**
   * Assert element has text
   */
  async expectText(locatorName: string, text: string): Promise<void> {
    const locator = this[locatorName] as Locator;
    await expect(locator).toHaveText(text);
  }

  /**
   * Assert element count
   */
  async expectCount(locatorName: string, count: number): Promise<void> {
    const locator = this[locatorName] as Locator;
    await expect(locator).toHaveCount(count);
  }

  // ============================================
  // HELPER METHODS
  // ============================================

  /**
   * Wait for field validation to complete
   */
  private async waitForFieldValidation(fieldName: string): Promise<void> {
    const field = this[`${fieldName}`] as Locator;
    // Wait for validation attribute to settle
    await this.page.waitForTimeout(300);
  }

  /**
   * Take screenshot for debugging
   */
  async screenshot(name: string): Promise<Buffer> {
    return await this.page.screenshot({
      path: `test-results/screenshots/${this.constructor.name}-${name}-${Date.now()}.png`,
      fullPage: true,
    });
  }

  /**
   * Get page performance metrics
   */
  async getPerformanceMetrics(): Promise<Record<string, number>> {
    return await this.page.evaluate(() => {
      const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming;
      return {
        domContentLoaded: navigation.domContentLoadedEventEnd - navigation.domContentLoadedEventStart,
        loadComplete: navigation.loadEventEnd - navigation.loadEventStart,
        firstPaint: performance.getEntriesByType('paint').find(p => p.name === 'first-paint')?.startTime || 0,
        firstContentfulPaint: performance.getEntriesByType('paint').find(p => p.name === 'first-contentful-paint')?.startTime || 0,
      };
    });
  }
}

// ============================================
// BASE PAGE CLASS (Shared)
// ============================================

export class BasePage {
  readonly page: Page;

  constructor(page: Page) {
    this.page = page;
  }

  async goto(path: string): Promise<void> {
    await this.page.goto(path, { waitUntil: 'domcontentloaded' });
  }

  async waitForPageReady(): Promise<void> {
    await this.page.waitForLoadState('networkidle');
  }

  async waitForResponse(urlPattern: string | RegExp): Promise<void> {
    await this.page.waitForResponse(urlPattern);
  }

  async waitForModal(modalName: string): Promise<void> {
    await this.page.locator(`[data-testid="modal-${modalName}"]`).waitFor({ state: 'visible' });
  }

  async getUrl(): Promise<string> {
    return this.page.url();
  }

  async reload(): Promise<void> {
    await this.page.reload({ waitUntil: 'domcontentloaded' });
  }

  async goBack(): Promise<void> {
    await this.page.goBack();
  }

  async hover(locator: Locator): Promise<void> {
    await locator.hover();
  }

  async scrollIntoView(locator: Locator): Promise<void> {
    await locator.scrollIntoViewIfNeeded();
  }

  async waitForElement(locator: Locator, timeout = 5000): Promise<void> {
    await locator.waitFor({ state: 'visible', timeout });
  }
}

