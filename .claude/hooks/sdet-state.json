{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "sdet-*",
        "command": "node .sdet-skills/scripts/state-helpers.js save"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "sdet-*",
        "command": "node .sdet-skills/scripts/state-helpers.js load"
      }
    ]
  }
}