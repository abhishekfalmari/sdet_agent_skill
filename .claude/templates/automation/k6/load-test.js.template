import http from 'k6/http';
import { check, sleep, group, fail } from 'k6';
import { Rate, Trend, Counter, Gauge } from 'k6/metrics';
import { SharedArray } from 'k6/data';
import { htmlReport } from 'https://raw.githubusercontent.com/benc-uk/k6-reporter/main/dist/bundle.js';

// ============================================
// CUSTOM METRICS
// ============================================

// Error rates
export const errorRate = new Rate('errors');
export const apiErrorRate = new Rate('api_errors');

// Response times
export const responseTime = new Trend('response_time', true);
export const apiResponseTime = new Trend('api_response_time', true);
export const pageLoadTime = new Trend('page_load_time', true);

// Business metrics
export const ordersCreated = new Counter('orders_created');
export const paymentsProcessed = new Counter('payments_processed');
export const usersRegistered = new Counter('users_registered');

// System metrics
export const activeUsers = new Gauge('active_users');
export const cpuUsage = new Gauge('cpu_usage');
export const memoryUsage = new Gauge('memory_usage');

// ============================================
// CONFIGURATION
// ============================================

export const options = {
  // Test type: 'load', 'stress', 'soak', 'spike', 'breakpoint'
  testType: __ENV.TEST_TYPE || 'load',

  // Stages for different test types
  stages: getStages(__ENV.TEST_TYPE || 'load'),

  // Thresholds - PASS/FAIL criteria
  thresholds: {
    // HTTP
    'http_req_duration': ['p(95)<500', 'p(99)<1000'],
    'http_req_failed': ['rate<0.01'],

    // Custom
    'errors': ['rate<0.05'],
    'api_errors': ['rate<0.01'],
    'response_time': ['p(95)<500', 'p(99)<1000'],
    'api_response_time': ['p(95)<300', 'p(99)<800'],
    'page_load_time': ['p(95)<2500'],

    // Business
    'orders_created': ['count>0'],
    'checks': ['rate>0.95'],
  },

  // Export options
  summaryTrendStats: ['avg', 'min', 'med', 'max', 'p(90)', 'p(95)', 'p(99)', 'p(99.9)'],

  // Cloud execution
  ext: {
    loadimpact: {
      projectID: __ENV.K6_PROJECT_ID,
      name: '{{PROJECT_NAME}} Load Test',
    },
  },

  // No usage report
  noUsageReport: true,

  // Tags for filtering
  tags: {
    project: '{{PROJECT_NAME}}',
    environment: __ENV.ENVIRONMENT || 'staging',
    testType: __ENV.TEST_TYPE || 'load',
    buildId: __ENV.BUILD_ID || 'local',
  },
};

// ============================================
// STAGE CONFIGURATIONS
// ============================================

function getStages(testType) {
  const configs = {
    // Load test - expected production load
    load: [
      { duration: '2m', target: 10 },   // Ramp up
      { duration: '5m', target: 50 },   // Steady state
      { duration: '2m', target: 100 },  // Peak
      { duration: '5m', target: 50 },   // Steady state
      { duration: '2m', target: 0 },    // Ramp down
    ],

    // Stress test - beyond capacity
    stress: [
      { duration: '2m', target: 10 },
      { duration: '5m', target: 100 },
      { duration: '10m', target: 200 },
      { duration: '10m', target: 500 },
      { duration: '5m', target: 1000 }, // Find breaking point
      { duration: '5m', target: 0 },
    ],

    // Soak test - sustained load for long period
    soak: [
      { duration: '10m', target: 50 },
      { duration: '2h', target: 100 },  // 2 hours sustained
      { duration: '10m', target: 0 },
    ],

    // Spike test - sudden traffic burst
    spike: [
      { duration: '1m', target: 10 },
      { duration: '30s', target: 500 }, // Sudden spike
      { duration: '1m', target: 10 },
      { duration: '30s', target: 500 }, // Another spike
      { duration: '1m', target: 0 },
    ],

    // Breakpoint test - gradual increase
    breakpoint: [
      { duration: '5m', target: 10 },
      { duration: '10m', target: 50 },
      { duration: '10m', target: 100 },
      { duration: '10m', target: 200 },
      { duration: '10m', target: 400 },
      { duration: '10m', target: 800 },
      { duration: '5m', target: 0 },
    ],

    // Smoke test - quick validation
    smoke: [
      { duration: '30s', target: 1 },
      { duration: '1m', target: 5 },
      { duration: '30s', target: 0 },
    ],
  };

  return configs[testType] || configs.load;
}

// ============================================
// TEST DATA
// ============================================

// Load test data from CSV/JSON
const users = new SharedArray('users', function() {
  // In real scenario, load from file:
  // return JSON.parse(open('../data/users.json'));
  return generateUsers(1000);
});

const products = new SharedArray('products', function() {
  return generateProducts(500);
});

const promoCodes = ['SAVE10', 'WELCOME20', 'VIP25', 'FLASH50'];

// ============================================
// HELPER FUNCTIONS
// ============================================

function generateUsers(count) {
  const users = [];
  for (let i = 0; i < count; i++) {
    users.push({
      email: `user${i}@test.example.com`,
      password: 'TestPass123!',
      name: `Test User ${i}`,
      token: null,
      userId: null,
    });
  }
  return users;
}

function generateProducts(count) {
  const products = [];
  const categories = ['Electronics', 'Clothing', 'Home', 'Sports', 'Books'];
  for (let i = 0; i < count; i++) {
    products.push({
      id: `prod-${i}`,
      sku: `SKU-${String(i).padStart(6, '0')}`,
      name: `Product ${i}`,
      price: Math.floor(Math.random() * 1000) + 10,
      category: categories[Math.floor(Math.random() * categories.length)],
    });
  }
  return products;
}

function getBaseUrl() {
  return __ENV.BASE_URL || 'https://api-staging.example.com/v1';
}

function getHeaders(token = null) {
  const headers = {
    'Content-Type': 'application/json',
    'Accept': 'application/json',
    'User-Agent': 'k6-load-test/1.0',
  };
  if (token) {
    headers['Authorization'] = `Bearer ${token}`;
  }
  return headers;
}

function checkResponse(response, expectedStatus = 200, name = 'request') {
  const success = check(response, {
    [`${name} status is ${expectedStatus}`]: (r) => r.status === expectedStatus,
    [`${name} response time < 1000ms`]: (r) => r.timings.duration < 1000,
    [`${name} has body`]: (r) => r.body && r.body.length > 0,
  });

  errorRate.add(!success);
  apiErrorRate.add(!success);
  responseTime.add(response.timings.duration);
  apiResponseTime.add(response.timings.duration);

  return success;
}

// ============================================
// SCENARIOS
// ============================================

// Scenario 1: Browse Products
export function browseProducts() {
  group('Browse Products', () => {
    // List products with pagination
    let page = 1;
    const perPage = 20;

    for (let i = 0; i < 5; i++) {
      const response = http.get(
        `${getBaseUrl()}/products?page=${page}&perPage=${perPage}`,
        { headers: getHeaders(), tags: { name: 'ListProducts' } }
      );

      checkResponse(response, 200, 'ListProducts');
      page++;
      sleep(Math.random() * 2 + 1); // 1-3s think time
    }

    // Get single product
    const product = products[Math.floor(Math.random() * products.length)];
    const detailResponse = http.get(
      `${getBaseUrl()}/products/${product.id}`,
      { headers: getHeaders(), tags: { name: 'GetProduct' } }
    );

    checkResponse(detailResponse, 200, 'GetProduct');
    sleep(Math.random() * 1 + 0.5);
  });
}

// Scenario 2: Search Products
export function searchProducts() {
  group('Search Products', () => {
    const queries = ['laptop', 'phone', 'shoes', 'book', 'headphones'];
    const query = queries[Math.floor(Math.random() * queries.length)];

    const response = http.get(
      `${getBaseUrl()}/products?search=${query}&page=1&perPage=20`,
      { headers: getHeaders(), tags: { name: 'SearchProducts' } }
    );

    checkResponse(response, 200, 'SearchProducts');
    sleep(Math.random() * 1 + 0.5);
  });
}

// Scenario 3: User Authentication
export function authenticateUser(userData) {
  group('User Authentication', () => {
    // Login
    const loginResponse = http.post(
      `${getBaseUrl()}/auth/login`,
      JSON.stringify({
        email: userData.email,
        password: userData.password,
      }),
      { headers: getHeaders(), tags: { name: 'Login' } }
    );

    if (checkResponse(loginResponse, 200, 'Login')) {
      const data = loginResponse.json();
      userData.token = data.accessToken;
      userData.userId = data.user.id;
      usersRegistered.add(1);
    } else {
      // Register new user if login fails
      registerUser(userData);
    }
  });
}

function registerUser(userData) {
  group('User Registration', () => {
    const registerResponse = http.post(
      `${getBaseUrl()}/auth/register`,
      JSON.stringify({
        email: userData.email,
        password: userData.password,
        name: userData.name,
      }),
      { headers: getHeaders(), tags: { name: 'Register' } }
    );

    checkResponse(registerResponse, 201, 'Register');
    usersRegistered.add(1);
  });
}

// Scenario 4: Cart Operations
export function cartOperations(userData) {
  if (!userData.token) return;

  group('Cart Operations', () => {
    // Get cart
    let cartResponse = http.get(
      `${getBaseUrl()}/cart`,
      { headers: getHeaders(userData.token), tags: { name: 'GetCart' } }
    );
    checkResponse(cartResponse, 200, 'GetCart');

    // Add to cart
    const product = products[Math.floor(Math.random() * products.length)];
    const addResponse = http.post(
      `${getBaseUrl()}/cart/items`,
      JSON.stringify({
        productId: product.id,
        quantity: Math.floor(Math.random() * 3) + 1,
      }),
      { headers: getHeaders(userData.token), tags: { name: 'AddToCart' } }
    );

    if (checkResponse(addResponse, 200, 'AddToCart')) {
      // Update quantity
      const cart = addResponse.json();
      if (cart.items && cart.items.length > 0) {
        const itemId = cart.items[0].id;
        http.patch(
          `${getBaseUrl()}/cart/items/${itemId}`,
          JSON.stringify({ quantity: 2 }),
          { headers: getHeaders(userData.token), tags: { name: 'UpdateCart' } }
        );
      }
    }

    // Apply promo code
    const promoCode = promoCodes[Math.floor(Math.random() * promoCodes.length)];
    http.post(
      `${getBaseUrl()}/cart/promo`,
      JSON.stringify({ code: promoCode }),
      { headers: getHeaders(userData.token), tags: { name: 'ApplyPromo' } }
    );

    sleep(Math.random() * 2 + 1);
  });
}

// Scenario 5: Checkout & Order
export function checkoutOrder(userData) {
  if (!userData.token) return;

  group('Checkout & Order', () => {
    // Get cart first
    const cartResponse = http.get(
      `${getBaseUrl()}/cart`,
      { headers: getHeaders(userData.token), tags: { name: 'GetCartForCheckout' } }
    );

    if (!checkResponse(cartResponse, 200, 'GetCartForCheckout')) return;

    const cart = cartResponse.json();
    if (!cart.items || cart.items.length === 0) return;

    // Create order (simplified - assumes addresses/payment methods exist)
    const orderResponse = http.post(
      `${getBaseUrl()}/orders`,
      JSON.stringify({
        shippingAddressId: 'addr-1',
        billingAddressId: 'addr-1',
        shippingMethodId: 'ship-standard',
        paymentMethodId: 'pm-1',
      }),
      { headers: getHeaders(userData.token), tags: { name: 'CreateOrder' } }
    );

    if (checkResponse(orderResponse, 201, 'CreateOrder')) {
      ordersCreated.add(1);
      const order = orderResponse.json();

      // Get order details
      http.get(
        `${getBaseUrl()}/orders/${order.id}`,
        { headers: getHeaders(userData.token), tags: { name: 'GetOrder' } }
      );
    }

    sleep(Math.random() * 3 + 2);
  });
}

// Scenario 6: Payment Processing
export function processPayment(userData) {
  if (!userData.token) return;

  group('Payment Processing', () => {
    // Create payment intent
    const intentResponse = http.post(
      `${getBaseUrl()}/payment_intents`,
      JSON.stringify({
        amount: 10000, // $100.00 in cents
        currency: 'USD',
        payment_method_types: ['card'],
      }),
      { headers: getHeaders(userData.token), tags: { name: 'CreatePaymentIntent' } }
    );

    if (checkResponse(intentResponse, 200, 'CreatePaymentIntent')) {
      const intent = intentResponse.json();

      // Confirm payment (using test payment method)
      http.post(
        `${getBaseUrl()}/payment_intents/${intent.id}/confirm`,
        JSON.stringify({
          payment_method: 'pm_card_visa', // Stripe test payment method
        }),
        { headers: getHeaders(userData.token), tags: { name: 'ConfirmPayment' } }
      );

      paymentsProcessed.add(1);
    }
  });
}

// ============================================
// MAIN VU FUNCTION
// ============================================

export default function() {
  // Get unique user for this VU
  const userIndex = __VU % users.length;
  const userData = users[userIndex];

  // Track active users
  activeUsers.add(1);

  try {
    // Authenticate user
    authenticateUser(userData);

    // Simulate user journey
    const journey = Math.random();

    if (journey < 0.3) {
      // 30% - Browse only
      browseProducts();
      searchProducts();
    } else if (journey < 0.6) {
      // 30% - Browse + Cart
      browseProducts();
      cartOperations(userData);
    } else if (journey < 0.85) {
      // 25% - Full checkout
      browseProducts();
      cartOperations(userData);
      checkoutOrder(userData);
    } else {
      // 15% - Payment only (existing users)
      processPayment(userData);
    }

    // Random think time between journeys
    sleep(Math.random() * 5 + 2);
  } finally {
    activeUsers.add(-1);
  }
}

