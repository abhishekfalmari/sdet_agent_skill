# GitHub Actions CI/CD Pipeline Template
# Generated by SDET Agent Skill Pack
#
# Place in: .github/workflows/ci.yml
#
# Usage: Replace {{PLACEHOLDERS}} with actual values

name: {{PROJECT_NAME}} CI/CD Pipeline

on:
  push:
    branches: [main, develop, 'release/**']
    tags: ['v*']
  pull_request:
    branches: [main, develop, 'release/**']
  workflow_dispatch:
    inputs:
      testType:
        description: 'Test type to run'
        type: choice
        options: [quick, full, security, performance, contract]
        default: 'quick'
      environment:
        description: 'Target environment'
        type: choice
        options: [staging, production]
        default: 'staging'
      autoApprove:
        description: 'Auto-approve deployment gates'
        type: boolean
        default: false

  schedule:
    # Daily full test suite
    - cron: '0 2 * * *'
    # Weekly performance test
    - cron: '0 3 * * 0'
    # Monthly security scan
    - cron: '0 4 1 * *'

env:
  # Project configuration
  PROJECT_NAME: {{PROJECT_NAME}}
  NODE_VERSION: '20.x'
  PNPM_VERSION: '9.x'

  # Test configuration
  TEST_PARALLEL_JOBS: 4
  TEST_RETRY_COUNT: 2
  TEST_SHARD_STRATEGY: duration

  # Quality gates
  UNIT_COVERAGE_THRESHOLD: 80
  INTEGRATION_COVERAGE_THRESHOLD: 70
  E2E_COVERAGE_THRESHOLD: 100
  PERFORMANCE_LATENCY_P95: 500
  PERFORMANCE_ERROR_RATE: 0.01

  # Deployment
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}
  KUBECONFIG_STAGING: ${{ secrets.KUBECONFIG_STAGING }}
  KUBECONFIG_PRODUCTION: ${{ secrets.KUBECONFIG_PRODUCTION }}

# ============================================
# PERMISSIONS
# ============================================

permissions:
  contents: read
  packages: write
  security-events: write
  actions: read
  checks: write
  deployments: write
  statuses: write
  pull-requests: write

# ============================================
# JOBS
# ============================================

jobs:
  # --------------------------------------------
  # ANALYZE: Requirement Analysis
  # --------------------------------------------
  analyze:
    name: Analyze Requirements
    runs-on: ubuntu-latest
    if: github.event_name != 'pull_request' || github.event.pull_request.draft == false
    outputs:
      requirements-path: ${{ steps.analyze.outputs.requirements-path }}
      requirements-count: ${{ steps.analyze.outputs.requirements-count }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run requirement analysis
        id: analyze
        run: |
          npx @sdet/analyze --source ./requirements --format json
          echo "requirements-path=artifacts/requirements/structured-requirements.json" >> $GITHUB_OUTPUT
          echo "requirements-count=$(jq '.requirements | length' artifacts/requirements/structured-requirements.json)" >> $GITHUB_OUTPUT

      - name: Upload requirements artifact
        uses: actions/upload-artifact@v4
        with:
          name: requirements
          path: artifacts/requirements/
          retention-days: 30

  # --------------------------------------------
  # GENERATE: Test Case Generation
  # --------------------------------------------
  generate:
    name: Generate Test Cases
    runs-on: ubuntu-latest
    needs: analyze
    if: github.event_name != 'pull_request' || github.event.pull_request.draft == false
    outputs:
      testcases-path: ${{ steps.generate.outputs.testcases-path }}
      testcases-count: ${{ steps.generate.outputs.testcases-count }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Download requirements
        uses: actions/download-artifact@v4
        with:
          name: requirements
          path: artifacts/requirements/

      - name: Generate test cases
        id: generate
        run: |
          npx @sdet/generate --template standard --includeNegative --includeBoundary
          echo "testcases-path=$(ls -t artifacts/test-cases/test-cases-*.xlsx | head -1)" >> $GITHUB_OUTPUT
          echo "testcases-count=$(npx @sdet/validate --file $(ls -t artifacts/test-cases/test-cases-*.xlsx | head -1) --json | jq '.summary.total')" >> $GITHUB_OUTPUT

      - name: Upload test cases artifact
        uses: actions/upload-artifact@v4
        with:
          name: test-cases
          path: artifacts/test-cases/
          retention-days: 30

  # --------------------------------------------
  # VALIDATE: Test Case Validation
  # --------------------------------------------
  validate:
    name: Validate Test Cases
    runs-on: ubuntu-latest
    needs: generate
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Download test cases
        uses: actions/download-artifact@v4
        with:
          name: test-cases
          path: artifacts/test-cases/

      - name: Validate test cases
        run: |
          npx @sdet/validate --file ${{ needs.generate.outputs.testcases-path }} --strict --json

      - name: Upload validation report
        uses: actions/upload-artifact@v4
        with:
          name: validation-report
          path: artifacts/validation/
          retention-days: 30

  # --------------------------------------------
  # AUTOMATE: Automation Code Generation
  # --------------------------------------------
  automate:
    name: Generate Automation Code
    runs-on: ubuntu-latest
    needs: validate
    if: github.event_name != 'pull_request' || github.event.pull_request.draft == false
    outputs:
      automation-files: ${{ steps.automate.outputs.automation-files }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Download test cases
        uses: actions/download-artifact@v4
        with:
          name: test-cases
          path: artifacts/test-cases/

      - name: Generate automation code
        id: automate
        run: |
          npx @sdet/automate --type ui,api,security,performance,accessibility,contract --framework playwright,pactum,k6,semgrep,zap,axe,pact --pattern pom
          echo "automation-files=$(find tests -type f -name '*.ts' -o -name '*.js' -o -name '*.py' | tr '\n' ' ')" >> $GITHUB_OUTPUT

      - name: Upload automation code
        uses: actions/upload-artifact@v4
        with:
          name: automation-code
          path: tests/
          retention-days: 30

  # --------------------------------------------
  # LINT & TYPECHECK
  # --------------------------------------------
  lint-and-typecheck:
    name: Lint & TypeCheck
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run linter
        run: pnpm lint

      - name: Run typecheck
        run: pnpm typecheck

      - name: Check formatting
        run: pnpm format:check

  # --------------------------------------------
  # UNIT TESTS
  # --------------------------------------------
  unit-tests:
    name: Unit Tests
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run unit tests
        run: |
          pnpm test:unit --coverage --reporter=jest-junit --outputFile=junit.xml

      - name: Check coverage threshold
        run: |
          COVERAGE=$(cat coverage/coverage-summary.json | jq '.total.lines.pct')
          if (( $(echo "$COVERAGE < ${{ env.UNIT_COVERAGE_THRESHOLD }}" | bc -l) )); then
            echo "Unit test coverage $COVERAGE% is below threshold ${{ env.UNIT_COVERAGE_THRESHOLD }}%"
            exit 1
          fi

      - name: Upload coverage
        uses: actions/upload-artifact@v4
        with:
          name: unit-coverage
          path: coverage/
          retention-days: 7

      - name: Upload JUnit results
        uses: actions/upload-artifact@v4
        with:
          name: unit-junit
          path: junit.xml
          retention-days: 7

  # --------------------------------------------
  # INTEGRATION TESTS
  # --------------------------------------------
  integration-tests:
    name: Integration Tests
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_DB: test
          POSTGRES_USER: test
          POSTGRES_PASSWORD: test
        ports: [5432:5432]
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
      redis:
        image: redis:7-alpine
        ports: [6379:6379]
        options: --health-cmd "redis-cli ping" --health-interval 10s --health-timeout 5s --health-retries 5

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run database migrations
        run: pnpm db:migrate
        env:
          DATABASE_URL: postgresql://test:test@localhost:5432/test

      - name: Run integration tests
        run: |
          pnpm test:integration --reporter=jest-junit --outputFile=junit.xml

      - name: Upload JUnit results
        uses: actions/upload-artifact@v4
        with:
          name: integration-junit
          path: junit.xml
          retention-days: 7

  # --------------------------------------------
  # CONTRACT TESTS
  # --------------------------------------------
  contract-tests:
    name: Contract Tests (Pact)
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run contract tests
        run: |
          pnpm test:contract

      - name: Can I Deploy?
        if: github.event_name == 'pull_request' || github.ref == 'refs/heads/main'
        run: |
          npx @pactflow/can-i-deploy \
            --pacticipant=${{ env.PROJECT_NAME }} \
            --version=${{ github.sha }} \
            --environment=staging \
            --broker-base-url=${{ secrets.PACT_BROKER_URL }} \
            --broker-token=${{ secrets.PACT_BROKER_TOKEN }}

  # --------------------------------------------
  # E2E TESTS (Playwright)
  # --------------------------------------------
  e2e-tests:
    name: E2E Tests (Playwright)
    runs-on: ubuntu-latest
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        shard: [1, 2, 3, 4]
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Install Playwright browsers
        run: pnpm playwright install --with-deps chromium

      - name: Run E2E tests (shard ${{ matrix.shard }}/${{ strategy.job-total }})
        run: |
          pnpm playwright test --shard=${{ matrix.shard }}/${{ strategy.job-total }} --retry=${{ env.TEST_RETRY_COUNT }} --reporter=junit,line

      - name: Upload test artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: e2e-results-shard-${{ matrix.shard }}
          path: |
            test-results/
            playwright-report/
          retention-days: 7

  # --------------------------------------------
  # VISUAL REGRESSION
  # --------------------------------------------
  visual-regression:
    name: Visual Regression (Chromatic)
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request' || github.ref == 'refs/heads/main'
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run Chromatic
        uses: chromaui/action@v1
        with:
          projectToken: ${{ secrets.CHROMATIC_PROJECT_TOKEN }}
          buildScriptName: build:storybook
          exitZeroOnChanges: true
          autoAcceptChanges: main
          onlyChanged: true

  # --------------------------------------------
  # PERFORMANCE TESTS (k6)
  # --------------------------------------------
  performance-tests:
    name: Performance Tests (k6)
    runs-on: ubuntu-latest
    if: github.event_name == 'schedule' || github.event.inputs.testType == 'performance' || github.event_name == 'workflow_dispatch'
    timeout-minutes: 90
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup k6
        uses: grafana/k6-action@v0.2.0

      - name: Run k6 load test
        run: |
          k6 run \
            --vus=${{ env.K6_VUS || 100 }} \
            --duration=${{ env.K6_DURATION || 10m }} \
            --out json=results.json \
            --out influxdb=http://${{ secrets.INFLUXDB_URL }} \
            tests/performance/load-test.js

      - name: Check performance thresholds
        run: |
          npx @sdet/analyze-results --file results.json --thresholds ${{ env.PERFORMANCE_LATENCY_P95 }},${{ env.PERFORMANCE_ERROR_RATE }}

      - name: Upload k6 results
        uses: actions/upload-artifact@v4
        with:
          name: k6-results
          path: results.json
          retention-days: 30

  # --------------------------------------------
  # SECURITY TESTS
  # --------------------------------------------
  security-sast:
    name: SAST (CodeQL + Semgrep)
    runs-on: ubuntu-latest
    permissions:
      security-events: write
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: javascript, typescript, python, go, rust
          config-file: .github/codeql-config.yml

      - name: Run CodeQL Analysis
        uses: github/codeql-action/analyze@v3
        with:
          category: "/language:javascript"
          upload: true

      - name: Run Semgrep
        uses: returntocorp/semgrep-action@v1
        with:
          config: >-
            p/ci
            p/secrets
            p/javascript
            p/typescript
            p/python
            p/go
            p/rust
          generateSarif: true

      - name: Upload Semgrep SARIF
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: semgrep.sarif

  security-sca:
    name: SCA (Trivy + Snyk)
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Run Trivy
        uses: aquasecurity/trivy-action@master
        with:
          scan-type: 'fs'
          scan-ref: '.'
          format: 'sarif'
          output: 'trivy.sarif'
          severity: 'CRITICAL,HIGH'
          ignore-unfixed: true

      - name: Upload Trivy SARIF
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: trivy.sarif

      - name: Run Snyk
        uses: snyk/actions/node@master
        if: env.SNYK_TOKEN != ''
        with:
          command: test
          args: --severity-threshold=high --sarif-file-output=snyk.sarif

      - name: Upload Snyk SARIF
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: snyk.sarif
        if: env.SNYK_TOKEN != ''

  security-secrets:
    name: Secrets Detection (TruffleHog)
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Run TruffleHog
        uses: trufflesecurity/trufflehog@main
        with:
          path: ./
          base: main
          head: HEAD
          extra_args: --json --fail

  security-dast:
    name: DAST (OWASP ZAP)
    runs-on: ubuntu-latest
    if: github.event_name == 'schedule' || github.event.inputs.testType == 'security'
    services:
      app:
        image: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:staging
        ports: [3000:3000]
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Run ZAP Scan
        uses: zaproxy/action-baseline@v0.12.0
        with:
          target: 'http://localhost:3000'
          rules_file_name: '.zap/rules.tsv'
          cmd_options: '-a'

  # --------------------------------------------
  # ACCESSIBILITY TESTS
  # --------------------------------------------
  accessibility-tests:
    name: Accessibility Tests
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run axe-core tests
        run: |
          pnpm test:a11y

      - name: Upload a11y results
        uses: actions/upload-artifact@v4
        with:
          name: a11y-results
          path: test-results/a11y/
          retention-days: 7

  # --------------------------------------------
  # BUILD & PUBLISH
  # --------------------------------------------
  build:
    name: Build & Publish Artifacts
    runs-on: ubuntu-latest
    needs: [lint-and-typecheck, unit-tests, integration-tests, contract-tests, e2e-tests, visual-regression]
    if: github.ref == 'refs/heads/main' || github.ref == 'refs/heads/develop' || startsWith(github.ref, 'refs/heads/release/') || startsWith(github.ref, 'refs/tags/v')
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=branch
            type=ref,event=pr
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=sha
            type=raw,value=latest,enable={{is_default_branch}}

      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          platforms: linux/amd64,linux/arm64
          provenance: true
          sbom: true

      - name: Sign images with cosign
        if: github.ref == 'refs/tags/v*'
        uses: sigstore/cosign-installer@v3
        with:
          cosign-release: 'v2.2.0'

      - name: Sign container images
        if: github.ref == 'refs/tags/v*'
        run: |
          cosign sign --yes ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}@${{ steps.meta.outputs.digest }}

  # --------------------------------------------
  # DEPLOY STAGING
  # --------------------------------------------
  deploy-staging:
    name: Deploy to Staging
    runs-on: ubuntu-latest
    needs: build
    if: github.ref == 'refs/heads/main' || github.ref == 'refs/heads/develop'
    environment: staging
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Configure kubectl
        uses: azure/k8s-set-context@v4
        with:
          kubeconfig: ${{ secrets.KUBECONFIG_STAGING }}

      - name: Deploy with ArgoCD
        run: |
          argocd app sync ${{ env.PROJECT_NAME }}-staging \
            --prune \
            --auto-prune \
            --server=${{ secrets.ARGOCD_SERVER }} \
            --auth-token=${{ secrets.ARGOCD_TOKEN }}

      - name: Wait for deployment
        run: |
          argocd app wait ${{ env.PROJECT_NAME }}-staging \
            --health \
            --timeout 300 \
            --server=${{ secrets.ARGOCD_SERVER }} \
            --auth-token=${{ secrets.ARGOCD_TOKEN }}

      - name: Run smoke tests
        run: |
          pnpm test:smoke --base-url=https://staging.${{ env.PROJECT_NAME }}.example.com

  # --------------------------------------------
  # DEPLOY PRODUCTION
  # --------------------------------------------
  deploy-production:
    name: Deploy to Production
    runs-on: ubuntu-latest
    needs: deploy-staging
    if: github.ref == 'refs/heads/main' && github.event_name == 'push' || startsWith(github.ref, 'refs/tags/v')
    environment: production
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Manual approval
        if: github.event.inputs.autoApprove != 'true'
        uses: trstringer/manual-approval@v1
        with:
          secret: ${{ github.token }}
          approvers: release-managers
          minimum-approvals: 2
          issue-title: "Production Deployment Approval for ${{ github.ref_name }}"
          issue-body: "Please review and approve deployment to production."

      - name: Configure kubectl
        uses: azure/k8s-set-context@v4
        with:
          kubeconfig: ${{ secrets.KUBECONFIG_PRODUCTION }}

      - name: Deploy with ArgoCD (Canary)
        run: |
          argocd app set ${{ env.PROJECT_NAME }}-production \
            --parameter canary.enabled=true \
            --parameter canary.weight=10 \
            --server=${{ secrets.ARGOCD_SERVER }} \
            --auth-token=${{ secrets.ARGOCD_TOKEN }}

          argocd app sync ${{ env.PROJECT_NAME }}-production \
            --prune \
            --auto-prune \
            --server=${{ secrets.ARGOCD_SERVER }} \
            --auth-token=${{ secrets.ARGOCD_TOKEN }}

      - name: Monitor canary
        run: |
          # Wait and check metrics for 10 minutes
          sleep 600
          # Check error rate, latency
          # If healthy, promote to 100%

      - name: Promote to 100%
        run: |
          argocd app set ${{ env.PROJECT_NAME }}-production \
            --parameter canary.weight=100 \
            --server=${{ secrets.ARGOCD_SERVER }} \
            --auth-token=${{ secrets.ARGOCD_TOKEN }}

      - name: Post-deployment smoke tests
        run: |
          pnpm test:smoke --base-url=https://${{ env.PROJECT_NAME }}.example.com

      - name: Create deployment record
        run: |
          gh api repos/${{ github.repository }}/deployments \
            -f environment=production \
            -f ref=${{ github.sha }} \
            -f task=deploy \
            -f description="Production deployment ${{ github.ref_name }}"

  # --------------------------------------------
  # ANALYZE RESULTS
  # --------------------------------------------
  analyze-results:
    name: Analyze Test Results
    runs-on: ubuntu-latest
    needs: [unit-tests, integration-tests, e2e-tests, performance-tests, security-sast, security-sca, accessibility-tests]
    if: always()
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'pnpm'

      - name: Install pnpm
        uses: pnpm/action-setup@v3
        with:
          version: ${{ env.PNPM_VERSION }}

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Download all test artifacts
        uses: actions/download-artifact@v4
        with:
          path: artifacts/
          merge-multiple: true

      - name: Analyze results
        run: |
          npx @sdet/analyze-results \
            --updateExcel \
            --createDefects \
            --junitDir artifacts/ \
            --k6Results artifacts/k6-results/results.json \
            --output artifacts/analysis/

      - name: Upload analysis report
        uses: actions/upload-artifact@v4
        with:
          name: analysis-report
          path: artifacts/analysis/
          retention-days: 30

      - name: Comment on PR
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const report = fs.readFileSync('artifacts/analysis/summary.md', 'utf8');
            await github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: report
            })

  # --------------------------------------------
  # NOTIFY
  # --------------------------------------------
  notify:
    name: Notify Results
    runs-on: ubuntu-latest
    needs: [analyze-results, deploy-staging, deploy-production]
    if: always()
    steps:
      - name: Send Slack notification
        uses: 8398a7/action-slack@v3
        with:
          status: ${{ job.status }}
          channel: '#{{PROJECT_NAME}}-ci'
          text: |
            ${{ github.workflow }} - ${{ job.status }}
            Repository: ${{ github.repository }}
            Branch: ${{ github.ref_name }}
            Commit: ${{ github.sha }}
            Run: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}

      - name: Send Teams notification
        uses: skation/teams-notification@v1
        with:
          webhook_url: ${{ secrets.TEAMS_WEBHOOK_URL }}
          title: "${{ github.workflow }} - ${{ job.status }}"
          text: |
            Repository: ${{ github.repository }}
            Branch: ${{ github.ref_name }}
            Commit: ${{ github.sha }}

      - name: Send email on failure
        if: failure()
        uses: dawidd6/action-send-mail@v3
        with:
          server_address: smtp.gmail.com
          server_port: 465
          username: ${{ secrets.EMAIL_USERNAME }}
          password: ${{ secrets.EMAIL_PASSWORD }}
          subject: "CI/CD Failed: ${{ github.workflow }}"
          to: team@example.com
          from: CI/CD Bot
          body: |
            Pipeline failed for ${{ github.repository }}
            Run: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}