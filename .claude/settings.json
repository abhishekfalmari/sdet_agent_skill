{
  "permissions": {
    "allow": [
      "Bash(npx sdet-*)",
      "Bash(node .sdet-skills/scripts/*)",
      "Read(.claude/context/**)",
      "Write(.claude/context/**)",
      "Write(artifacts/**)",
      "Read(artifacts/**)",
      "Glob(**)",
      "Grep(**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "sdet-*", "command": "node .sdet-skills/scripts/state-helpers.js load" }
    ],
    "PostToolUse": [
      { "matcher": "sdet-*", "command": "node .sdet-skills/scripts/state-helpers.js save" },
      { "matcher": "sdet-*", "command": "node .sdet-skills/scripts/context-helpers.js export" }
    ]
  },
  "skills": {
    "autoLoad": true,
    "paths": [
      ".claude/commands",
      ".sdet-skills/.claude/commands"
    ]
  }
}